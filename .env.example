# 複製一份改名為 .env，填入真實值（.env 已被 .gitignore 排除，不會上傳 GitHub）
# 產生隨機密碼：python -c "import secrets; print(secrets.token_urlsafe(24))"
# 密碼只用英文、數字、- 和 _，docker compose 組網址時才不會出錯

# 本機 TimescaleDB（docker 容器 timescaledb）的 postgres 密碼
POSTGRES_PASSWORD=change-me

# 在本機直接執行 uvicorn、MCP server、訓練腳本時連到哪裡（預設值如下，通常不用改）
# DB_HOST=localhost
# DB_PORT=5435

# ---------- Tiger Cloud（Phase 1 雲端同步）----------
# tsdbadmin：只給 python -m tools.cloud_admin 建表、建帳號用，backend 平常不會讀它
TIGER_URL=postgres://tsdbadmin:change-me@your-service.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require
# edge_writer：backend 同步用（只能新增、更新）；用 python -m tools.cloud_admin password edge_writer 設密碼後填入
TIGER_EDGE_URL=postgres://edge_writer:change-me@your-service.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require
# mcp_reader：之後雲端 MCP 用（只能讀）
TIGER_READER_URL=postgres://mcp_reader:change-me@your-service.tsdb.cloud.timescale.com:12345/tsdb?sslmode=require
# 設成 true 才會啟動同步；不同步的設備後綴（逗號分隔，預設 -MOCK）
CLOUD_SYNC_ENABLED=false
# SYNC_EXCLUDE_SUFFIXES=-MOCK

# ---------- 登入（安全性第二批）----------
# 允許呼叫 API 的前端網址，逗號分隔。用 Tailscale IP 開前端時要加上，例如 http://100.89.23.28:3000
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 登入有效時數（預設 12）
# SESSION_HOURS=12
# 改用 HTTPS 後設成 true，cookie 就只會走加密連線
# COOKIE_SECURE=false
